# Скопируйте в .env и заполните реальные значения
OPENAI_API_KEY=your-api-key-here

# Модель по умолчанию (для gpustack/deepseek)
OPENAI_MODEL=deepseek-v4-flash

# Base URL API (для OpenAI оставьте пустым, для шлюзов укажите)
OPENAI_BASE_URL=https://gpustack.data.lmru.tech/v1

# Параметры по умолчанию для запросов
# DEFAULT_TEMPERATURE=0.7
# DEFAULT_MAX_TOKENS=1024
